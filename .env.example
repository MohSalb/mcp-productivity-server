# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real credentials.
#
# These are loaded via python-dotenv (see src/productivity_mcp/config.py),
# NOT via os.path, and NOT set as permanent system environment variables.

# --- SMTP credentials for send_email_draft -------------------------------
# For Gmail: use an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), NOT your real account password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-address@gmail.com

# --- Rate limiting ---------------------------------------------------------
# Max calls allowed per tool within the sliding window below.
RATE_LIMIT_MAX_CALLS=5
RATE_LIMIT_WINDOW_SECONDS=60
